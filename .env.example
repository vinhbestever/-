# Elasticsearch
CALLLOG_ELASTICSEARCH_HOSTS=http://localhost:9200
CALLLOG_ELASTICSEARCH_USERNAME=
CALLLOG_ELASTICSEARCH_PASSWORD=
CALLLOG_ELASTICSEARCH_CALL_LOG_INDEX=call-logs

# Kafka
CALLLOG_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CALLLOG_KAFKA_TOPIC_RAW=call-logs-raw
CALLLOG_KAFKA_TOPIC_ENRICHED=call-logs-enriched
CALLLOG_KAFKA_CONSUMER_GROUP=call-log-enrichment-group

# Enrichment
CALLLOG_ENRICHMENT_ENABLED=true
CALLLOG_SPACY_MODEL=en_core_web_sm

# API
CALLLOG_API_HOST=0.0.0.0
CALLLOG_API_PORT=8000
CALLLOG_LOG_LEVEL=INFO
CALLLOG_DEBUG=false
